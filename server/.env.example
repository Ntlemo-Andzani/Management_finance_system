# Copy this file to .env and fill in your own values.
#
#   PowerShell:  Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env
#
# .env is never committed — it is listed in .gitignore. This file is the
# template that is committed in its place.

PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------- database ---
# A local MySQL install: fill these in and leave DATABASE_URL blank.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Wrap the value in double quotes if it contains # or a space, or dotenv will
# read everything from the # onward as a comment and cut the password short:
#   DB_PASSWORD="my#pass word"
DB_PASSWORD=
DB_NAME=mfms

# A managed database (TiDB Cloud, Clever Cloud, Railway) usually gives you one
# connection string instead. When this is set it overrides the five settings
# above, so a deployment needs one variable rather than five.
#   DATABASE_URL=mysql://user:password@host:4000/mfms
DATABASE_URL=

# Leave TLS off for a local MySQL on the loopback interface; every managed
# database requires it and will refuse the connection without it.
#   true      TLS, server certificate verified   <- use this when deploying
#   insecure  TLS, certificate NOT verified      <- only to diagnose a failure
DB_SSL=

# Only needed by a provider that issues certificates from its own certificate
# authority rather than a publicly trusted one (Aiven does; TiDB Cloud does
# not). Give a path to the .pem file, or paste the PEM text itself.
#   DB_SSL_CA=certs/ca.pem
DB_SSL_CA=

# --------------------------------------------------------------------- auth ---
# This key signs every session token. The value below is a placeholder and is
# published in this file and in the project report, so the server refuses to
# start with it when NODE_ENV=production. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------- deployment ---
# Production only. The front end is served by this same process, so the browser
# is already on the right origin and this can stay empty. Set it only if a
# different site must call this API, as a comma-separated list of origins.
CORS_ORIGIN=
